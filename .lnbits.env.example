# Local Docker access. Require HTTPS when exposing LNbits outside this machine.
HOST=0.0.0.0
AUTH_HTTPS_ONLY=false
AUTH_SECRET_KEY="replace-with-a-random-hex-value"
AUTH_ALLOWED_METHODS="user-id-only,username-password"
LNBITS_ADMIN_UI=true

# The password must match DB_PASSWORD in the root .env file.
LNBITS_DATABASE_URL="postgres://lnbits:replace-with-the-db-password@db:5432/lnbits"
LNBITS_DATA_FOLDER="/app/data"
LNBITS_EXTENSIONS_PATH="/app/data/extensions"

# VoidWallet supports initial setup without moving real funds.
LNBITS_BACKEND_WALLET_CLASS=VoidWallet

# Replace VoidWallet above and uncomment this value to use Alby Hub via NWC.
# LNBITS_BACKEND_WALLET_CLASS=NWCWallet
# NWC_PAIRING_URL="nostr+walletconnect://replace-with-the-alby-hub-pairing-url"

# Require this token on the first-install page when the port is not locally restricted.
# FIRST_INSTALL_TOKEN="replace-with-a-random-hex-value"
