GIT_COMMIT_URL_TEMPLATE=https://github.com/cadbos/CadbosUI/commit/{commit}
GIT_RELEASE_URL_TEMPLATE=https://github.com/cadbos/CadbosUI/releases/tag/v{version}
NOSTR_CONNECT_RELAYS=wss://relay.damus.io,wss://nos.lol
NOSTR_PROFILE_BOOTSTRAP_RELAYS=wss://nostr.band,wss://nostr-pub.wellorder.net

# Local Robokassa Worker bindings. Provide actual credentials in this ignored
# .env file, then set the same five credentials as Cloudflare Worker secrets.
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_IS_TEST=true
# ROBOKASSA_TEST_DEPOSIT_LIMIT_CENTS=50
ROBOKASSA_HASH_ALGORITHM=md5
