{
	"name": "cadbos-ui",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-06-26",
	"compatibility_flags": ["nodejs_als", "nodejs_compat", "global_fetch_strictly_public"],
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Auth storage (Module 2). `database_id` is a placeholder for local development;
	// the production id is created with `wrangler d1 create cadbos-temp` and set here
	// before deploy. Apply the schema locally with:
	//   wrangler d1 migrations apply DB --local
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cadbos-temp",
			"database_id": "f111d591-8ba0-48fe-89d4-d8ea3677b5f0",
			"migrations_dir": "migrations"
		}
	],
	// Provisioned with `wrangler r2 bucket create cadbos-uploads`.
	// `remote: true` makes local dev (`platformProxy`, remote bindings on by
	// default) read/write the real bucket instead of the local emulation, so
	// UPLOADS_PUBLIC_URL (which points at the production CDN) resolves to
	// files that actually exist.
	"r2_buckets": [
		{
			"binding": "UPLOADS_BUCKET",
			"bucket_name": "cadbos-uploads",
			"remote": true
		}
	],
	// ComfyUI runs on a private VPS, reachable only through this VPC Service
	// (Cloudflare Tunnel `comfyui-equuleus` -> localhost:8188), never over the
	// public internet — it has no built-in auth. `remote: true` routes local
	// dev through the real tunnel too, same as UPLOADS_BUCKET above.
	"vpc_services": [
		{
			"binding": "COMFYUI_BASE_URL",
			"service_id": "019f8921-fb99-7ca1-af8b-be63288ae38b",
			"remote": true
		},
		{
			"binding": "LNBITS_VPC",
			"service_id": "019fd6e5-6967-7c41-9ef4-ec825404baf2",
			"remote": true
		}
	]
	// Secrets set via `wrangler secret put <NAME>` — never committed to source:
	// ARCHAI_API_KEY
	// LNBITS_INVOICE_KEY
	//
	// Payment configuration also requires PAYMENTS_WEBHOOK_URL. The webhook URL
	// ends in /api/webhooks/lnbits.
	//
	// Generation access itself is controlled in D1, not an env var. Provision the
	// user's immutable `app_credit` ledger account and opening transaction before
	// inserting an enabled `generation_access` row. Revoke or restore access by
	// updating `generation_access.enabled`; adjust balances only with new ledger entries.
}
