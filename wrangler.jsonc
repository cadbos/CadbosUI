{
	"name": "cadbos-ui",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-06-26",
	"compatibility_flags": ["nodejs_als", "nodejs_compat", "global_fetch_strictly_public"],
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Auth storage (Module 2). `database_id` is a placeholder for local development;
	// the production id is created with `wrangler d1 create cadbos-auth` and set here
	// before deploy. Apply the schema locally with:
	//   wrangler d1 migrations apply DB --local
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cadbos-auth",
			"database_id": "d1f2f49c-bb39-473c-ae35-2d78eebcbc53",
			"migrations_dir": "migrations"
		}
	],
	// Workers AI translates Create prompts to English before they reach archAI
	// (src/lib/server/prompt-translation.ts). It always runs on Cloudflare, so
	// local dev calls it too and spends the account's daily Neurons.
	"ai": {
		"binding": "AI",
		"remote": true
	},
	// Worker variables configured per environment in Cloudflare:
	// CLOUDFLARE_ACCOUNT_ID
	// CLOUDFLARE_GRAPHQL_URL (optional, default https://api.cloudflare.com/client/v4/graphql)
	// D1_DAILY_ROWS_READ_LIMIT (optional, default 5000000)
	// D1_DAILY_ROWS_WRITTEN_LIMIT (optional, default 100000)
	// MEDIA_CACHE_TTL_SECONDS (optional, default 31536000)
	// RENDER_MEDIA_TTL_SECONDS (optional, default 10800)
	// S3_UPLOADS_BUCKET_NAME (optional, default cadbos-uploads)
	// COMFYUI_JOB_TIMEOUT_MS (optional, default 600000)
	// COMFYUI_REQUEST_TIMEOUT_MS (optional, default 120000)
	// COMFYUI_POLL_INTERVAL_SECONDS (optional, default 2; integers 1 through 2147483)
	// RENDER_TIMEOUT_MS (optional, default 120000)
	// Timeout values are integer milliseconds from 1 through 2147483647.
	// ComfyUI runs on a private VPS, reachable only through this VPC Service
	// (Cloudflare Tunnel `comfyui-equuleus` -> localhost:8188), never over the
	// public internet — it has no built-in auth. `remote: true` routes local
	// dev through the real tunnel too.
	"vpc_services": [
		{
			"binding": "COMFYUI_BASE_URL",
			"service_id": "019f8921-fb99-7ca1-af8b-be63288ae38b",
			"remote": true
		}
	]
	// Secrets set via `wrangler secret put <NAME>` — never committed to source:
	// ARCHAI_API_KEY
	// FEATUREBASE_APP_ID
	// FEATUREBASE_JWT_SECRET
	// CLOUDFLARE_ANALYTICS_API_TOKEN (Account Analytics Read permission)
	// S3_ACCESS_KEY_ID
	// S3_SECRET_ACCESS_KEY
	// ROBOKASSA_LOGIN
	// ROBOKASSA_PASSWORD1
	// ROBOKASSA_PASSWORD2
	// ROBOKASSA_TEST_PASSWORD1
	// ROBOKASSA_TEST_PASSWORD2
	//
	// Optional Worker variables configured per environment in Cloudflare:
	// ROBOKASSA_IS_TEST (defaults to true; set false for live mode)
	// ROBOKASSA_TEST_DEPOSIT_LIMIT_CENTS (nonnegative USD cents; unset disables the limit)
	// ROBOKASSA_HASH_ALGORITHM (md5, sha256, or sha512; defaults to md5)
	//
	// Generation access itself is controlled in D1, not an env var: an account
	// can render/edit only once an admin inserts a row for it into the `credits`
	// table (see the workflow note in migrations/0004_generation_access.sql).
}
