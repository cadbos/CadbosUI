{
	"name": "cadbos-deposit-reconciler",
	"main": "src/workers/deposit-reconciler.ts",
	"compatibility_date": "2026-06-26",
	"compatibility_flags": ["nodejs_als", "nodejs_compat", "global_fetch_strictly_public"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"triggers": {
		"crons": ["* * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cadbos-temp",
			"database_id": "f111d591-8ba0-48fe-89d4-d8ea3677b5f0",
			"migrations_dir": "migrations"
		}
	],
	"vpc_services": [
		{
			"binding": "LNBITS_VPC",
			"service_id": "019fd6e5-6967-7c41-9ef4-ec825404baf2",
			"remote": true
		}
	]
}
